# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh

# Plugins are chosen deliberately; see the notes below before adding more.
#   - mise, docker, and docker-compose are deliberately absent: mise is
#     activated in zshrc before this file, and Docker completion already comes
#     from OrbStack's own completion directory.
#   - zoxide replaces the older `z` plugin; both define `z`, so enable one.
#   - zsh-syntax-highlighting wraps existing widgets, so it must load after
#     every plugin that defines one, and history-substring-search after it.
plugins=(
  git
  macos
  fzf
  zoxide
  extract
  dirhistory
  colored-man-pages
  command-not-found
  zsh-autosuggestions
  zsh-syntax-highlighting
  history-substring-search
)

ZSH_THEME="robbyrussell"
source $ZSH/oh-my-zsh.sh
