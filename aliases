#!/bin/bash

# Detect which `ls` flavor is in use
if ls --color >/dev/null 2>&1; then # GNU `ls`
  colorflag="--color"
  export LS_COLORS='no=00:fi=00:di=01;31:ln=01;36:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'
else # macOS `ls`
  colorflag="-G"
  export LSCOLORS='BxBxhxDxfxhxhxhxhxcxcx'
fi

# List all files colorized in long format
alias ll="ls -lF ${colorflag}"
# List all dotfiles in long format
alias ll.="ls -ld -FH ${colorflag} .*"
# List all files colorized in long format, including dot files
alias la="ls -laF ${colorflag}"
# List only directories
alias lld="ls -lF ${colorflag} | grep --color=never '^d'"
# Always use color output for `ls`
alias ls="command ls -F ${colorflag}"

# Always enable colored `grep` output
# Note: `GREP_OPTIONS="--color=auto"` is deprecated, hence the alias usage.
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'
alias grep='grep --color=auto'

alias tailf='tail -f'

alias mkdir="mkdir -p"
alias e="$EDITOR"
alias v="$VISUAL"

# IP addresses
# OpenDNS retired its myip resolver; Cloudflare's TXT record is the DNS
# equivalent and stays faster than an HTTPS round trip.
alias ip='dig +short txt ch whoami.cloudflare @1.0.0.1 | tr -d "\""'
alias localip="ipconfig getifaddr en0"
alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Pretty print the path
alias path='echo $PATH | tr -s ":" "\n"'

# Tmux Plugins
alias tmux_plugins_install="~/.tmux/plugins/tpm/bin/install_plugins"
alias tmux_plugins_update="~/.tmux/plugins/tpm/bin/update_plugins all"

# postgres
# alias psql='psql -h $POSTGRES_HOST -U postgres'

# macOS has no `md5sum`, so use `md5` as a fallback
command -v md5sum >/dev/null || alias md5sum="md5"
# macOS has no `sha1sum`, so use `shasum` as a fallback
command -v sha1sum >/dev/null || alias sha1sum="shasum"

# Surge (this Mac) hands out fake-IPs only to resolvers that go through it.
# Tools that resolve DNS on their own -- bun, npm, curl -- connect to the real
# IP instead, so Surge sees a bare-IP connection, every DOMAIN rule is skipped,
# and the traffic falls through to FINAL. Routing them at Surge's local proxy
# gives it the hostname back and the rules match again.
# socks5h, not socks5: socks5 resolves locally and reproduces the very bug.
export SURGE_HTTP_PROXY="http://127.0.0.1:6152"
export SURGE_SOCKS_PROXY="socks5h://127.0.0.1:6153"
export SURGE_NO_PROXY="localhost,127.0.0.1,::1,.local"

surge-proxied() {
  http_proxy="$SURGE_HTTP_PROXY" https_proxy="$SURGE_HTTP_PROXY" all_proxy="$SURGE_SOCKS_PROXY" \
  HTTP_PROXY="$SURGE_HTTP_PROXY" HTTPS_PROXY="$SURGE_HTTP_PROXY" ALL_PROXY="$SURGE_SOCKS_PROXY" \
  no_proxy="$SURGE_NO_PROXY" NO_PROXY="$SURGE_NO_PROXY" \
  command "$@"
}

alias bun='surge-proxied bun'
alias npm='surge-proxied npm'
alias curl='surge-proxied curl'
alias pi='surge-proxied pi'
alias codex='https_proxy=http://127.0.0.1:6152 http_proxy=http://127.0.0.1:6152 all_proxy=socks5://127.0.0.1:6153 command codex'

# Machine-local aliases; stays out of this repository.
[[ -f ~/.aliases.local ]] && source ~/.aliases.local
