#!/usr/bin/env bash
#
# Reproduce the tmux a/A window-creation behavior for Herdr tabs.
#
# Herdr 0.7.5 exposes tab.move through its public socket API, but does not
# provide a matching CLI subcommand. The remaining operations use the CLI.
#
# Tabs inserted after a tab named "zsh" form a group renamed in display order
# with small roman numerals: zsh, zshⅱ, zshⅲ. Inserting before a tab joins the
# group of the tab to its left; inserting at the front takes over the front
# tab's group name, with the whole group renumbered by position; appending at
# the end joins the last tab's group. Every tab also carries a "N." position
# prefix so prefix+1..9 switching stays predictable (Herdr shows no indices).

set -euo pipefail

usage() {
  printf 'usage: herdr-smart-tab <before|after|first|last> [--focus|--no-focus]\n' >&2
  printf '       herdr-smart-tab <close-tab|close-pane|renumber|renumber-all>\n' >&2
}

mode="${1:-}"
case "$mode" in
  before | after | first | last)
    focus_option="${2:---focus}"
    if [ "$#" -gt 2 ]; then
      usage
      exit 2
    fi
    case "$focus_option" in
      --focus | --no-focus) ;;
      *)
        usage
        exit 2
        ;;
    esac
    ;;
  close-tab | close-pane | renumber | renumber-all)
    if [ "$#" -ne 1 ]; then
      usage
      exit 2
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac

socket_path="${HERDR_SOCKET_PATH:-}"
workspace_id="${HERDR_ACTIVE_WORKSPACE_ID:-}"
requested_tab_id="${HERDR_ACTIVE_TAB_ID:-}"
requested_pane_id="${HERDR_ACTIVE_PANE_ID:-}"
pane_cwd="${HERDR_ACTIVE_PANE_CWD:-${PWD:-}}"
herdr_bin="${HERDR_BIN_PATH:-}"

if [ -z "$herdr_bin" ]; then
  herdr_bin="$(command -v herdr || true)"
fi

notify_error() {
  local message="$1"
  printf 'herdr-smart-tab: %s\n' "$message" >&2
  if [ -n "$herdr_bin" ] && [ -x "$herdr_bin" ]; then
    "$herdr_bin" notification show "Unable to create Herdr tab" \
      --body "$message" >/dev/null 2>&1 || true
  fi
}

die() {
  notify_error "$1"
  exit 1
}

[ -n "$socket_path" ] || die "HERDR_SOCKET_PATH is unavailable"
[ -S "$socket_path" ] || die "Herdr socket is unavailable"
[ -n "$herdr_bin" ] && [ -x "$herdr_bin" ] || die "herdr binary is unavailable"
case "$mode" in
  renumber-all) ;;
  *)
    [ -n "$workspace_id" ] || die "active workspace is unavailable"
    [ -n "$requested_tab_id" ] || die "active tab is unavailable"
    ;;
esac
case "$mode" in
  close-tab | renumber | renumber-all) ;;
  close-pane)
    [ -n "$requested_pane_id" ] || die "active pane is unavailable"
    ;;
  *)
    [ -n "$pane_cwd" ] || die "active pane cwd is unavailable"
    ;;
esac

jq_bin="$(command -v jq || true)"
nc_bin="$(command -v nc || true)"
[ -n "$jq_bin" ] || die "jq is required"
[ -n "$nc_bin" ] || die "nc is required"

# Herdr runs custom shell commands detached. Serialize them per server so quick
# repeated keypresses cannot interleave create, move, and rename requests.
lock_key="$(printf '%s' "$socket_path" | cksum | awk '{print $1}')"
lock_root="${TMPDIR:-/tmp}"
lock_file="${lock_root%/}/herdr-smart-tab-${lock_key}.lock"
exec 9>"$lock_file"
if ! /usr/bin/lockf -s -t 5 9; then
  die "timed out waiting for another tab creation"
fi

# jq handles the multibyte suffix characters; the superscript and +N/-N
# patterns strip legacy label formats so they migrate on the next keypress.
strip_suffix() {
  "$jq_bin" -rn --arg label "$1" \
    '$label
     | sub("[ⅰ-ⅿ]+$"; "")
     | sub("\\([0-9]+\\)$"; "")
     | sub("[⁰¹²³⁴-⁹]+$"; "")
     | sub("([+-][0-9]+)+$"; "")'
}

strip_ordinal() {
  local label="$1"
  if [[ "$label" =~ ^[0-9]+\.(.*)$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '%s' "$label"
  fi
}

group_suffix() {
  case "$1" in
    2) printf 'ⅱ' ;;
    3) printf 'ⅲ' ;;
    4) printf 'ⅳ' ;;
    5) printf 'ⅴ' ;;
    6) printf 'ⅵ' ;;
    7) printf 'ⅶ' ;;
    8) printf 'ⅷ' ;;
    9) printf 'ⅸ' ;;
    10) printf 'ⅹ' ;;
    11) printf 'ⅺ' ;;
    12) printf 'ⅻ' ;;
    *) printf '(%s)' "$1" ;;
  esac
}

list_tabs() {
  local response
  if ! response="$("$herdr_bin" tab list --workspace "$workspace_id")"; then
    die "could not list tabs"
  fi
  if ! "$jq_bin" -e \
    '.result.type == "tab_list" and (.result.tabs | type == "array")' \
    >/dev/null <<<"$response"; then
    die "Herdr returned an invalid tab list"
  fi
  printf '%s' "$response"
}

move_tab() {
  local tab_id="$1"
  local insert_index="$2"
  local request_id request response

  request_id="herdr-smart-tab:$$:${RANDOM}"
  request="$("$jq_bin" -cn \
    --arg id "$request_id" \
    --arg tab_id "$tab_id" \
    --argjson insert_index "$insert_index" \
    '{id: $id, method: "tab.move", params: {
      tab_id: $tab_id,
      insert_index: $insert_index
    }}')"

  if ! response="$(printf '%s\n' "$request" | "$nc_bin" -U -w 2 "$socket_path")"; then
    die "tab.move request failed"
  fi
  if ! "$jq_bin" -e --arg id "$request_id" \
    '.id == $id and .result.type == "tab_list"' \
    >/dev/null <<<"$response"; then
    local api_message
    api_message="$("$jq_bin" -r '.error.message // "invalid tab.move response"' \
      <<<"$response" 2>/dev/null || true)"
    die "$api_message"
  fi
}

rename_tab() {
  local tab_id="$1"
  local label="$2"
  if ! "$herdr_bin" tab rename "$tab_id" "$label" >/dev/null; then
    die "could not rename tab $tab_id"
  fi
}

# Rename all group members in display order: base, baseⅱ, baseⅲ, ...
renumber_group() {
  local base="$1"
  local tabs_json item item_id item_label target_label index
  local -a group_ids group_labels

  group_ids=()
  group_labels=()
  tabs_json="$(list_tabs)"

  while IFS= read -r item; do
    item_id="$("$jq_bin" -r '.tab_id' <<<"$item")"
    item_label="$(strip_ordinal "$("$jq_bin" -r '.label' <<<"$item")")"
    if [ "$(strip_suffix "$item_label")" = "$base" ]; then
      group_ids[${#group_ids[@]}]="$item_id"
      group_labels[${#group_labels[@]}]="$item_label"
    fi
  done < <("$jq_bin" -c '.result.tabs[]' <<<"$tabs_json")

  for ((index = 0; index < ${#group_ids[@]}; index++)); do
    if [ "$index" -eq 0 ]; then
      target_label="$base"
    else
      target_label="${base}$(group_suffix "$((index + 1))")"
    fi
    if [ "${group_labels[$index]}" != "$target_label" ]; then
      rename_tab "${group_ids[$index]}" "$target_label"
    fi
  done
}

# Herdr does not display tab indices, so prefix every label with its 1-based
# position ("2.zsh") to keep prefix+1..9 switching predictable.
renumber_all() {
  local tabs_json item item_id item_label target_label
  local position=0

  tabs_json="$(list_tabs)"
  while IFS= read -r item; do
    position=$((position + 1))
    item_id="$("$jq_bin" -r '.tab_id' <<<"$item")"
    item_label="$("$jq_bin" -r '.label' <<<"$item")"
    target_label="${position}.$(strip_ordinal "$item_label")"
    if [ "$item_label" != "$target_label" ]; then
      rename_tab "$item_id" "$target_label"
    fi
  done < <("$jq_bin" -c '.result.tabs[]' <<<"$tabs_json")
}

renumber_all_groups() {
  local tabs_json item_label group_base
  local seen=$'\n'

  tabs_json="$(list_tabs)"
  while IFS= read -r item_label; do
    group_base="$(strip_suffix "$(strip_ordinal "$item_label")")"
    case "$seen" in
      *$'\n'"$group_base"$'\n'*) continue ;;
    esac
    seen="${seen}${group_base}"$'\n'
    renumber_group "$group_base"
  done < <("$jq_bin" -r '.result.tabs[].label' <<<"$tabs_json")
}

if [ "$mode" = "renumber" ]; then
  renumber_all_groups
  renumber_all
  exit 0
fi

if [ "$mode" = "renumber-all" ]; then
  while IFS= read -r workspace_id; do
    [ -n "$workspace_id" ] || continue
    renumber_all_groups
    renumber_all
  done < <("$herdr_bin" workspace list \
    | "$jq_bin" -r '.result.workspaces[].workspace_id')
  exit 0
fi

if [ "$mode" = "close-tab" ] || [ "$mode" = "close-pane" ]; then
  tabs_json="$(list_tabs)"
  closing_tab_id="$requested_tab_id"
  focused_tab_id="$("$jq_bin" -r \
    '[.result.tabs[] | select(.focused == true)][0].tab_id // empty' \
    <<<"$tabs_json")"
  if [ -n "$focused_tab_id" ]; then
    closing_tab_id="$focused_tab_id"
  fi
  if ! closing_label="$("$jq_bin" -er --arg tab_id "$closing_tab_id" \
    '.result.tabs[] | select(.tab_id == $tab_id) | .label' <<<"$tabs_json")"; then
    die "closing tab label is unavailable"
  fi
  base="$(strip_suffix "$(strip_ordinal "$closing_label")")"

  if [ "$mode" = "close-tab" ]; then
    if ! "$herdr_bin" tab close "$closing_tab_id" >/dev/null; then
      die "could not close tab"
    fi
  else
    if ! "$herdr_bin" pane close "$requested_pane_id" >/dev/null; then
      die "could not close pane"
    fi
  fi

  renumber_group "$base"
  renumber_all
  exit 0
fi

current_tab_id="$requested_tab_id"
current_index=""
base=""

if [ "$mode" = "after" ] || [ "$mode" = "before" ]; then
  tabs_before="$(list_tabs)"

  # A queued keypress should behave like tmux's synchronous binding: after the
  # previous invocation focuses its new tab, the next invocation uses it.
  focused_tab_id="$("$jq_bin" -r \
    '[.result.tabs[] | select(.focused == true)][0].tab_id // empty' \
    <<<"$tabs_before")"
  if [ -n "$focused_tab_id" ]; then
    current_tab_id="$focused_tab_id"
  fi

  if ! current_index="$("$jq_bin" -er --arg tab_id "$current_tab_id" \
    '.result.tabs | map(.tab_id) | index($tab_id)' <<<"$tabs_before")"; then
    die "source tab no longer exists"
  fi

  if [ "$mode" = "after" ]; then
    if ! current_label="$("$jq_bin" -er --arg tab_id "$current_tab_id" \
      '.result.tabs[] | select(.tab_id == $tab_id) | .label' <<<"$tabs_before")"; then
      die "source tab label is unavailable"
    fi
    base="$(strip_suffix "$(strip_ordinal "$current_label")")"
  elif [ "$current_index" -gt 0 ]; then
    if ! previous_label="$("$jq_bin" -er \
      ".result.tabs[$((current_index - 1))].label" <<<"$tabs_before")"; then
      die "previous tab label is unavailable"
    fi
    base="$(strip_suffix "$(strip_ordinal "$previous_label")")"
  else
    if ! front_label="$("$jq_bin" -er \
      '.result.tabs[0].label' <<<"$tabs_before")"; then
      die "front tab label is unavailable"
    fi
    base="$(strip_suffix "$(strip_ordinal "$front_label")")"
  fi
elif [ "$mode" = "first" ]; then
  tabs_before="$(list_tabs)"
  if ! front_label="$("$jq_bin" -er \
    '.result.tabs[0].label' <<<"$tabs_before")"; then
    die "front tab label is unavailable"
  fi
  base="$(strip_suffix "$(strip_ordinal "$front_label")")"
elif [ "$mode" = "last" ]; then
  tabs_before="$(list_tabs)"
  if ! last_label="$("$jq_bin" -er \
    '.result.tabs[-1].label' <<<"$tabs_before")"; then
    die "last tab label is unavailable"
  fi
  base="$(strip_suffix "$(strip_ordinal "$last_label")")"
fi

create_args=(tab create --workspace "$workspace_id" --cwd "$pane_cwd" "$focus_option")
if [ -n "$base" ]; then
  create_args+=(--label "$base")
fi

if ! create_response="$("$herdr_bin" "${create_args[@]}")"; then
  die "could not create tab"
fi
if ! new_tab_id="$("$jq_bin" -er '.result.tab.tab_id' <<<"$create_response")"; then
  die "Herdr did not return the new tab id"
fi

if [ "$mode" = "after" ] || [ "$mode" = "before" ]; then
  tabs_after_create="$(list_tabs)"
  if ! current_index="$("$jq_bin" -er --arg tab_id "$current_tab_id" \
    '.result.tabs | map(.tab_id) | index($tab_id)' <<<"$tabs_after_create")"; then
    die "source tab disappeared after tab creation"
  fi
fi

case "$mode" in
  first)
    move_tab "$new_tab_id" 0
    renumber_group "$base"
    ;;
  last)
    renumber_group "$base"
    ;;
  before)
    move_tab "$new_tab_id" "$current_index"
    renumber_group "$base"
    ;;
  after)
    move_tab "$new_tab_id" "$((current_index + 1))"
    renumber_group "$base"
    ;;
esac

renumber_all
