#!/usr/bin/python3
"""Run remote Herdr over Mosh with a local macOS image-paste bridge."""

import argparse
from concurrent.futures import ThreadPoolExecutor
import errno
import fcntl
import os
from pathlib import Path
import pty
import re
import select
import signal
import subprocess
import sys
import tempfile
import termios
import time
import tty


PASTE_START = b"\x1b[200~"
PASTE_END = b"\x1b[201~"
IMAGE_SHORTCUT = b"\x1bv"
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
MAX_IMAGE_BYTES = 20 * 1024 * 1024
ESCAPE_TIMEOUT = 0.1
REMOTE_PATH = re.compile(rb"/tmp/herdr-mosh-image\.[A-Za-z0-9]+/image\.png")
REMOTE_UPLOAD = """umask 077
image_dir=$(mktemp -d /tmp/herdr-mosh-image.XXXXXXXX) || exit 1
trap 'rm -f "$image_dir/image.png"; rmdir "$image_dir"' EXIT HUP INT TERM
cat > "$image_dir/image.png" || exit 1
test -s "$image_dir/image.png" || exit 1
printf '%s/image.png\n' "$image_dir"
trap - EXIT HUP INT TERM
"""
CLIPBOARD_SCRIPT = """on run argv
    set png_data to (the clipboard as «class PNGf»)
    set image_file to open for access POSIX file (item 1 of argv) with write permission
    try
        set eof image_file to 0
        write png_data to image_file
    on error error_message
        close access image_file
        error error_message
    end try
    close access image_file
end run
"""


class BridgeError(Exception):
    pass


class PasteInput:
    """Recognize image triggers without interpreting bytes inside text pastes."""

    def __init__(self):
        self.pending = b""
        self.in_paste = False

    def feed(self, data):
        self.pending += data
        events = []
        output = bytearray()
        while self.pending:
            if self.in_paste:
                if self.pending.startswith(PASTE_END):
                    output.extend(PASTE_END)
                    self.pending = self.pending[len(PASTE_END):]
                    self.in_paste = False
                elif PASTE_END.startswith(self.pending):
                    break
                else:
                    output.append(self.pending[0])
                    self.pending = self.pending[1:]
                continue

            if self.pending.startswith(PASTE_START):
                remainder = self.pending[len(PASTE_START):]
                if not remainder or (
                    PASTE_END.startswith(remainder) and remainder != PASTE_END
                ):
                    break
                if remainder.startswith(PASTE_END):
                    self.pending = remainder[len(PASTE_END):]
                else:
                    output.extend(PASTE_START)
                    self.pending = remainder
                    self.in_paste = True
                    continue
            elif self.pending.startswith(IMAGE_SHORTCUT):
                self.pending = self.pending[len(IMAGE_SHORTCUT):]
            elif PASTE_START.startswith(self.pending) or IMAGE_SHORTCUT.startswith(self.pending):
                break
            else:
                output.append(self.pending[0])
                self.pending = self.pending[1:]
                continue

            if output:
                events.append(bytes(output))
                output.clear()
            events.append(None)

        if output:
            events.append(bytes(output))
        return events

    def flush_escape(self):
        if self.in_paste or self.pending.startswith(PASTE_START):
            return b""
        pending, self.pending = self.pending, b""
        return pending


def read_clipboard_image():
    with tempfile.TemporaryDirectory(prefix="herdr-mosh-clipboard-") as directory:
        image_path = Path(directory) / "image.png"
        try:
            subprocess.run(
                ["/usr/bin/osascript", "-e", CLIPBOARD_SCRIPT, str(image_path)],
                check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                timeout=10,
            )
        except (subprocess.SubprocessError, OSError) as error:
            raise BridgeError("Cannot read a PNG image from the local clipboard.") from error
        with image_path.open("rb") as image_file:
            image = image_file.read(MAX_IMAGE_BYTES + 1)
        if len(image) > MAX_IMAGE_BYTES:
            raise BridgeError("Clipboard image exceeds 20 MiB.")
        if not image.startswith(PNG_SIGNATURE):
            raise BridgeError("The local clipboard did not provide a PNG image.")
        return image


def upload_image(host, image):
    try:
        result = subprocess.run(
            ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
             "--", host, REMOTE_UPLOAD],
            input=image, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            check=True, timeout=30,
        )
    except (subprocess.SubprocessError, OSError) as error:
        raise BridgeError("Image transfer failed; check SSH connectivity to " + host + ".") from error
    path = result.stdout.strip()
    if not REMOTE_PATH.fullmatch(path):
        raise BridgeError("Image transfer returned an unexpected remote path.")
    return path


def paste_image(host):
    return PASTE_START + upload_image(host, read_clipboard_image()) + PASTE_END


def write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def run_mosh(host, herdr_arguments):
    stdin_fd = sys.stdin.fileno()
    stdout_fd = sys.stdout.fileno()
    original_terminal = termios.tcgetattr(stdin_fd)
    child_pid, master_fd = pty.fork()
    if child_pid == 0:
        os.execvp("mosh", ["mosh", "--", host, "/opt/homebrew/bin/herdr", *herdr_arguments])

    def resize(_signum=None, _frame=None):
        size = fcntl.ioctl(stdin_fd, termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(master_fd, termios.TIOCSWINSZ, size)

    previous_resize = signal.signal(signal.SIGWINCH, resize)
    parser = PasteInput()
    last_input_at = time.monotonic()
    pending_events = []
    transfer = None
    executor = ThreadPoolExecutor(max_workers=1)
    child_status = None
    try:
        resize()
        tty.setraw(stdin_fd)
        while True:
            if transfer is None and time.monotonic() - last_input_at >= ESCAPE_TIMEOUT:
                pending = parser.flush_escape()
                if pending:
                    pending_events.append(pending)
            if transfer is not None and transfer.done():
                try:
                    write_all(master_fd, transfer.result())
                except (BridgeError, OSError) as error:
                    write_all(stdout_fd, ("\r\n[herdr-mosh] " + str(error) + "\r\n").encode())
                transfer = None

            while pending_events and transfer is None:
                event = pending_events.pop(0)
                if event is None:
                    transfer = executor.submit(paste_image, host)
                else:
                    write_all(master_fd, event)

            # Keep drawing Mosh output during upload, but preserve input order:
            # keys typed after the shortcut must follow the image path.
            readers = [master_fd] if transfer is not None else [master_fd, stdin_fd]
            readable, _, _ = select.select(readers, [], [], ESCAPE_TIMEOUT)
            if master_fd in readable:
                try:
                    data = os.read(master_fd, 65536)
                except OSError as error:
                    if error.errno != errno.EIO:
                        raise
                    break
                if not data:
                    break
                write_all(stdout_fd, data)
            if stdin_fd in readable:
                data = os.read(stdin_fd, 65536)
                if not data:
                    break
                last_input_at = time.monotonic()
                pending_events.extend(parser.feed(data))
    finally:
        signal.signal(signal.SIGWINCH, previous_resize)
        termios.tcsetattr(stdin_fd, termios.TCSADRAIN, original_terminal)
        os.close(master_fd)
        waited_pid, child_status = os.waitpid(child_pid, os.WNOHANG)
        if not waited_pid:
            try:
                os.kill(child_pid, signal.SIGHUP)
            except ProcessLookupError:
                pass
            _, child_status = os.waitpid(child_pid, 0)
        executor.shutdown(wait=True)
    return os.waitstatus_to_exitcode(child_status)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("host", help="SSH host alias for the remote Mac")
    parser.add_argument("herdr_arguments", nargs=argparse.REMAINDER)
    arguments = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.@:\[\]-]*", arguments.host):
        parser.error("invalid SSH host")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.error("an interactive terminal is required")
    return run_mosh(arguments.host, arguments.herdr_arguments)


if __name__ == "__main__":
    sys.exit(main())
