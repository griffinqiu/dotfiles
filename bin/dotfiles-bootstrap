#!/bin/sh

set -efu

OH_MY_ZSH_REV=97b27bb2ec0701330b18c2d3e340b22e742b3fa8
ZSH_AUTOSUGGESTIONS_REV=85919cd1ffa7d2d5412f6d3fe437ebdbeeec4fc5
ZSH_SYNTAX_HIGHLIGHTING_REV=c4d95591843d49838b7ad30081e7aba3135a6703
TPM_REV=99469c4a9b1ccf77fade25842dc7bafbc8ce9946
GRUVBOX_REV=5d15b2765f59754d7ac263c88a0f6e3e58124951

usage() {
  cat <<'EOF'
Usage: dotfiles-bootstrap [--only COMPONENTS] [--upgrade] [--optional]
       dotfiles-bootstrap --check [--optional]

  --only      Run only comma-separated components:
              packages, links, runtimes, plugins.
  --upgrade   Upgrade managed packages and unlocked plugin sets explicitly.
  --optional  Include Brewfile.optional with the packages component.
  --check     Compatibility alias for the read-only dotfiles-doctor command.

With no --only option, all four installation components run in order.
EOF
}

die() {
  printf 'dotfiles-bootstrap: %s\n' "$*" >&2
  exit 2
}

symlink_points_to_path() {
  link_path=$1
  expected_path=$2

  [ -L "$link_path" ] || return 1
  link_target=$(readlink "$link_path") || return 1
  case "$link_target" in
    /*) ;;
    *) link_target=$(dirname -- "$link_path")/$link_target ;;
  esac

  link_parent=$(CDPATH='' cd -P -- "$(dirname -- "$link_target")" 2>/dev/null && pwd) ||
    return 1
  expected_parent=$(CDPATH='' cd -P -- "$(dirname -- "$expected_path")" 2>/dev/null && pwd) ||
    return 1
  [ "$link_parent/$(basename -- "$link_target")" = \
    "$expected_parent/$(basename -- "$expected_path")" ]
}

symlink_resolves_to() {
  link_path=$1
  expected_path=$2
  [ -L "$link_path" ] && [ -e "$link_path" ] &&
    [ -e "$expected_path" ] && [ "$link_path" -ef "$expected_path" ]
}

retired_link_is_owned() {
  link_name=$1
  link_path=$2
  expected_path=$3
  strict=$4

  if symlink_points_to_path "$link_path" "$expected_path"; then
    return 0
  fi
  if [ -L "$link_path" ] || [ -e "$link_path" ]; then
    $strict && die "refusing foreign $link_name path: $link_path"
  fi
  return 1
}

remove_retired_link() {
  link_name=$1
  link_path=$2
  expected_path=$3

  symlink_points_to_path "$link_path" "$expected_path" ||
    die "$link_name changed after preflight: $link_path"
  rm -- "$link_path"
  printf 'Removed retired %s symlink: %s\n' "$link_name" "$link_path"
}

resolve_repo_root() {
  if [ -n "${DOTFILES_ROOT:-}" ]; then
    CDPATH='' cd -P -- "$DOTFILES_ROOT" && pwd
    return
  fi

  script_path=$0
  while [ -L "$script_path" ]; do
    script_dir=$(CDPATH='' cd -P -- "$(dirname -- "$script_path")" && pwd)
    script_path=$(readlink "$script_path")
    case "$script_path" in
      /*) ;;
      *) script_path=$script_dir/$script_path ;;
    esac
  done
  CDPATH='' cd -P -- "$(dirname -- "$script_path")/.." && pwd
}

check_only=false
upgrade=false
optional=false
selection_requested=false
selected_components=
run_packages=false
run_links=false
run_runtimes=false
run_plugins=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --check) check_only=true ;;
    --upgrade) upgrade=true ;;
    --optional) optional=true ;;
    --only)
      [ "$#" -ge 2 ] || die '--only requires a component list'
      [ -n "$2" ] || die '--only requires a non-empty component list'
      selection_requested=true
      selected_components="${selected_components}${selected_components:+,}$2"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done

$check_only && $upgrade && die '--check and --upgrade cannot be combined'
$check_only && $selection_requested &&
  die '--check and --only cannot be combined'

if $selection_requested; then
  case "$selected_components" in
    ,* | *, | *,,*) die 'invalid empty component in --only' ;;
  esac

  old_ifs=$IFS
  IFS=,
  for selected_component in $selected_components; do
    case "$selected_component" in
      packages) run_packages=true ;;
      links) run_links=true ;;
      runtimes) run_runtimes=true ;;
      plugins) run_plugins=true ;;
      *) die "unknown --only component: $selected_component" ;;
    esac
  done
  IFS=$old_ifs
else
  run_packages=true
  run_links=true
  run_runtimes=true
  run_plugins=true
fi

if $optional && ! $check_only && ! $run_packages; then
  die '--optional requires the packages component'
fi
if $upgrade && ! $run_packages && ! $run_plugins; then
  die '--upgrade requires the packages or plugins component'
fi

repo_root=$(resolve_repo_root) || die 'cannot resolve repository root'

if $check_only; then
  doctor=${DOTFILES_DOCTOR_BIN:-$repo_root/bin/dotfiles-doctor}
  [ -x "$doctor" ] || die "doctor is not executable: $doctor"
  doctor_args=
  $optional && doctor_args=--optional
  exec "$doctor" $doctor_args
fi

if $run_packages; then
  [ -f "$repo_root/Brewfile" ] || die "missing $repo_root/Brewfile"
  if $optional; then
    [ -f "$repo_root/Brewfile.optional" ] ||
      die "missing $repo_root/Brewfile.optional"
  fi
fi
if $run_links; then
  [ -f "$repo_root/rcrc" ] || die "missing $repo_root/rcrc"
fi

[ "$(uname -s)" = Darwin ] || die 'bootstrap currently supports macOS only'
machine_arch=${DOTFILES_MACHINE_ARCH:-$(uname -m)}
[ "$machine_arch" = arm64 ] ||
  die 'bootstrap currently supports Apple-silicon macOS only (macos-arm64 lockfile)'

if $run_links; then
  codex_instructions=$HOME/.codex/AGENTS.md
  codex_instructions_backup=$codex_instructions.pre-dotfiles
  codex_instructions_expected=$repo_root/codex/AGENTS.md
  migrate_codex_instructions=false
  if [ -L "$codex_instructions" ]; then
    symlink_resolves_to "$codex_instructions" "$codex_instructions_expected" ||
      die "refusing foreign or dangling Codex instructions symlink: $codex_instructions"
  elif [ -e "$codex_instructions" ]; then
    [ -f "$codex_instructions" ] && [ ! -s "$codex_instructions" ] ||
      die "refusing conflicting Codex instructions path: $codex_instructions"
    if [ -e "$codex_instructions_backup" ] || [ -L "$codex_instructions_backup" ]; then
      die "cannot preserve empty Codex instructions; backup already exists: $codex_instructions_backup"
    fi
    migrate_codex_instructions=true
  fi

  mise_home_config=$HOME/.config/mise/config.toml
  mise_home_config_backup=$mise_home_config.pre-dotfiles
  mise_home_config_expected=$repo_root/config/mise/config.toml
  migrate_mise_config=false
  if [ -L "$mise_home_config" ]; then
    symlink_resolves_to "$mise_home_config" "$mise_home_config_expected" ||
      die "refusing foreign or dangling Mise config symlink: $mise_home_config"
  elif [ -e "$mise_home_config" ]; then
    [ -f "$mise_home_config" ] ||
      die "refusing conflicting Mise config path: $mise_home_config"
    if [ -e "$mise_home_config_backup" ] || [ -L "$mise_home_config_backup" ]; then
      die "cannot preserve Mise config; backup already exists: $mise_home_config_backup"
    fi
    migrate_mise_config=true
  fi

  standalone_mise=$HOME/.local/bin/mise
  standalone_mise_backup=$standalone_mise.pre-dotfiles
  homebrew_mise=/opt/homebrew/bin/mise
  migrate_standalone_mise=false
  if [ -L "$standalone_mise" ]; then
    symlink_points_to_path "$standalone_mise" "$homebrew_mise" ||
      die "refusing foreign or dangling standalone Mise symlink: $standalone_mise"
  elif [ -e "$standalone_mise" ]; then
    [ -f "$standalone_mise" ] ||
      die "refusing conflicting standalone Mise path: $standalone_mise"
    if [ -e "$standalone_mise_backup" ] || [ -L "$standalone_mise_backup" ]; then
      die "cannot preserve standalone Mise; backup already exists: $standalone_mise_backup"
    fi
    migrate_standalone_mise=true
  fi

  cleanup_root_claude=false
  cleanup_root_agents=false
  cleanup_agrc=false
  if retired_link_is_owned 'root Claude instructions' \
    "$HOME/.CLAUDE.md" "$repo_root/CLAUDE.md" true; then
    cleanup_root_claude=true
  fi
  if retired_link_is_owned 'root Codex instructions' \
    "$HOME/.AGENTS.md" "$repo_root/AGENTS.md" true; then
    cleanup_root_agents=true
  fi
  if retired_link_is_owned 'ag configuration' \
    "$HOME/.agrc" "$repo_root/agrc" false; then
    cleanup_agrc=true
  fi
fi

if [ -n "${DOTFILES_BREW_BIN:-}" ]; then
  brew_bin=$DOTFILES_BREW_BIN
else
  brew_bin=$(command -v brew || true)
fi
if $run_packages; then
  [ -n "$brew_bin" ] && [ -x "$brew_bin" ] || {
    printf '%s\n' 'Homebrew is required. Install it from https://brew.sh/ and rerun.' >&2
    exit 1
  }

  bundle_mode=--no-upgrade
  $upgrade && bundle_mode=--upgrade

  printf 'Installing core Homebrew dependencies (%s) ...\n' "$bundle_mode"
  "$brew_bin" bundle install "$bundle_mode" --file "$repo_root/Brewfile"

  if $optional; then
    printf 'Installing optional Homebrew dependencies (%s) ...\n' "$bundle_mode"
    "$brew_bin" bundle install "$bundle_mode" --file "$repo_root/Brewfile.optional"
  fi
fi

if $run_links; then
  if [ -n "${DOTFILES_RCUP_BIN:-}" ]; then
    rcup_bin=$DOTFILES_RCUP_BIN
  else
    # rcm may have been installed by the packages component immediately above.
    rcup_bin=$(command -v rcup || true)
    if [ ! -x "$rcup_bin" ] && [ -n "$brew_bin" ] && [ -x "$brew_bin" ]; then
      rcm_prefix=$("$brew_bin" --prefix rcm 2>/dev/null || true)
      [ -z "$rcm_prefix" ] || rcup_bin=$rcm_prefix/bin/rcup
    fi
  fi

  [ -n "$rcup_bin" ] && [ -x "$rcup_bin" ] || {
    printf '%s\n' 'rcup is unavailable; run the packages component first.' >&2
    exit 1
  }
fi

if $run_runtimes; then
  if [ -n "${DOTFILES_MISE_BIN:-}" ]; then
    mise_bin=$DOTFILES_MISE_BIN
  else
    mise_bin=
    if [ -n "$brew_bin" ] && [ -x "$brew_bin" ]; then
      mise_prefix=$("$brew_bin" --prefix mise 2>/dev/null || true)
      [ -z "$mise_prefix" ] || mise_bin=$mise_prefix/bin/mise
    fi
    if [ ! -x "$mise_bin" ]; then
      mise_bin=$(command -v mise || true)
    fi
  fi
  [ -n "$mise_bin" ] && [ -x "$mise_bin" ] || {
    printf '%s\n' 'mise is unavailable; run the packages component first.' >&2
    exit 1
  }
fi

bootstrap_tmp=
nvim_lock_tmp=
cleanup() {
  if [ -n "$bootstrap_tmp" ] && [ -d "$bootstrap_tmp" ]; then
    rm -rf -- "$bootstrap_tmp"
  fi
  if [ -n "$nvim_lock_tmp" ] && [ -f "$nvim_lock_tmp" ]; then
    rm -f -- "$nvim_lock_tmp"
  fi
}
trap cleanup EXIT HUP INT TERM

install_pinned_checkout() {
  checkout_name=$1
  checkout_url=$2
  checkout_revision=$3
  checkout_path=$4

  if [ -d "$checkout_path/.git" ]; then
    checkout_changes=$(
      "$git_bin" -C "$checkout_path" status --porcelain --untracked-files=all
    ) || die "cannot inspect $checkout_name checkout: $checkout_path"
    [ -z "$checkout_changes" ] ||
      die "$checkout_name contains local changes: $checkout_path"

    current_revision=$("$git_bin" -C "$checkout_path" rev-parse HEAD 2>/dev/null || true)
    if [ "$current_revision" != "$checkout_revision" ]; then
      if $upgrade; then
        printf 'Updating %s to pinned revision %s ...\n' \
          "$checkout_name" "$checkout_revision"
        "$git_bin" -C "$checkout_path" fetch --depth 1 \
          "$checkout_url" "$checkout_revision"
        "$git_bin" -C "$checkout_path" checkout --detach -q FETCH_HEAD
        current_revision=$("$git_bin" -C "$checkout_path" rev-parse HEAD)
        [ "$current_revision" = "$checkout_revision" ] || {
          printf 'failed to verify %s revision after upgrade\n' \
            "$checkout_name" >&2
          exit 1
        }
      else
        printf 'warning: %s is at %s; expected %s (left unchanged; use --upgrade)\n' \
          "$checkout_name" "${current_revision:-unknown}" \
          "$checkout_revision" >&2
      fi
    fi
    return
  fi

  if [ -e "$checkout_path" ]; then
    die "$checkout_name path exists but is not a Git checkout: $checkout_path"
  fi

  bootstrap_tmp=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-bootstrap.XXXXXX")
  "$git_bin" init -q "$bootstrap_tmp/repo"
  "$git_bin" -C "$bootstrap_tmp/repo" remote add origin "$checkout_url"
  "$git_bin" -C "$bootstrap_tmp/repo" fetch --depth 1 origin "$checkout_revision"
  "$git_bin" -C "$bootstrap_tmp/repo" checkout --detach -q FETCH_HEAD
  [ "$("$git_bin" -C "$bootstrap_tmp/repo" rev-parse HEAD)" = "$checkout_revision" ] || {
    printf 'failed to verify %s revision\n' "$checkout_name" >&2
    exit 1
  }
  mkdir -p "$(dirname -- "$checkout_path")"
  mv "$bootstrap_tmp/repo" "$checkout_path"
  rm -rf -- "$bootstrap_tmp"
  bootstrap_tmp=
  printf 'Installed %s at %s\n' "$checkout_name" "$checkout_revision"
}

preflight_plugins() {
  plugin_mode=$1

  nvim_plugin_runner=${DOTFILES_NVIM_PLUGIN_RUNNER:-}
  if [ -n "$nvim_plugin_runner" ]; then
    [ -x "$nvim_plugin_runner" ] ||
      die "Neovim plugin runner is not executable: $nvim_plugin_runner"
  else
    nvim_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/nvim
    [ -f "$nvim_config_dir/init.lua" ] ||
      die 'Neovim configuration is not linked; run the links component first'
    if [ -n "${DOTFILES_NVIM_BIN:-}" ]; then
      nvim_bin=$DOTFILES_NVIM_BIN
    else
      nvim_bin=$(command -v nvim || true)
    fi
    [ -n "$nvim_bin" ] && [ -x "$nvim_bin" ] ||
      die 'Neovim is unavailable; run the packages component first'
    nvim_plugin_script=$repo_root/config/nvim/lua/config/plugin-sync.lua
    [ -f "$nvim_plugin_script" ] ||
      die "missing Neovim plugin runner: $nvim_plugin_script"
  fi

  tpm_plugin_runner=${DOTFILES_TPM_PLUGIN_RUNNER:-}
  if [ -n "$tpm_plugin_runner" ]; then
    [ -x "$tpm_plugin_runner" ] ||
      die "TPM plugin runner is not executable: $tpm_plugin_runner"
  else
    tpm_install=$HOME/.tmux/plugins/tpm/bin/install_plugins
    tpm_update=$HOME/.tmux/plugins/tpm/bin/update_plugins
    [ -x "$tpm_install" ] ||
      die 'TPM is unavailable; run the packages component first'
    if [ "$plugin_mode" = update ]; then
      [ -x "$tpm_update" ] || die "missing TPM updater: $tpm_update"
    fi
    tmux_config=${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf
    [ -f "$tmux_config" ] || tmux_config=$HOME/.tmux.conf
    [ -f "$tmux_config" ] ||
      die 'tmux configuration is not linked; run the links component first'
    if [ -n "${DOTFILES_TMUX_BIN:-}" ]; then
      tmux_bin=$DOTFILES_TMUX_BIN
    else
      tmux_bin=$(command -v tmux || true)
    fi
    [ -n "$tmux_bin" ] && [ -x "$tmux_bin" ] ||
      die 'tmux is unavailable; run the packages component first'
    tmux_bin_dir=$(dirname -- "$tmux_bin")
  fi

  if [ -z "$nvim_plugin_runner" ] || [ -z "$tpm_plugin_runner" ]; then
    command -v git >/dev/null 2>&1 ||
      die 'git is required by the built-in plugin installers'
  fi
}

run_nvim_plugins() {
  plugin_mode=$1
  if [ -n "$nvim_plugin_runner" ]; then
    "$nvim_plugin_runner" "$plugin_mode"
    return
  fi

  if [ "$plugin_mode" = install ]; then
    nvim_lockfile=$nvim_config_dir/lazy-lock.json
    [ -f "$nvim_lockfile" ] ||
      die "Neovim lockfile is unavailable: $nvim_lockfile"
    nvim_lock_tmp=$(mktemp "${TMPDIR:-/tmp}/dotfiles-lazy-lock.XXXXXX")
    cp "$nvim_lockfile" "$nvim_lock_tmp"
    if DOTFILES_NVIM_SYNC_LOCKFILE="$nvim_lock_tmp" \
      DOTFILES_NVIM_CANONICAL_LOCKFILE="$nvim_lockfile" \
      "$nvim_bin" --headless -n -u "$nvim_config_dir/init.lua" \
      -l "$nvim_plugin_script" "$plugin_mode"; then
      nvim_status=0
    else
      nvim_status=$?
    fi
    rm -f -- "$nvim_lock_tmp"
    nvim_lock_tmp=
    return "$nvim_status"
  fi

  "$nvim_bin" --headless -n -u "$nvim_config_dir/init.lua" \
    -l "$nvim_plugin_script" "$plugin_mode"
}

run_tpm_plugins() {
  plugin_mode=$1
  if [ -n "$tpm_plugin_runner" ]; then
    "$tpm_plugin_runner" "$plugin_mode"
    return
  fi

  PATH="$tmux_bin_dir:$PATH" "$tpm_install"
  if [ "$plugin_mode" = update ]; then
    if ! tpm_update_output=$(PATH="$tmux_bin_dir:$PATH" "$tpm_update" all 2>&1); then
      printf '%s\n' "$tpm_update_output" >&2
      die 'TPM plugin update command failed'
    fi
    [ -z "$tpm_update_output" ] || printf '%s\n' "$tpm_update_output"
    if printf '%s\n' "$tpm_update_output" |
      grep -Eq 'update fail|not installed!'; then
      die 'one or more TPM plugin updates failed'
    fi
  fi
}

install_plugins() {
  plugin_mode=install
  $upgrade && plugin_mode=update
  preflight_plugins "$plugin_mode"
  printf 'Installing Neovim and tmux plugins (%s) ...\n' "$plugin_mode"
  run_nvim_plugins "$plugin_mode"
  run_tpm_plugins "$plugin_mode"
}

if $run_packages && [ "${DOTFILES_BOOTSTRAP_SKIP_GIT_DEPS:-0}" != 1 ]; then
  if [ -n "${DOTFILES_GIT_BIN:-}" ]; then
    git_bin=$DOTFILES_GIT_BIN
  else
    git_bin=$(command -v git || true)
  fi
  [ -n "$git_bin" ] && [ -x "$git_bin" ] || {
    printf '%s\n' 'git is unavailable after the packages component.' >&2
    exit 1
  }

  install_pinned_checkout \
    'Oh My Zsh' \
    'https://github.com/ohmyzsh/ohmyzsh.git' \
    "$OH_MY_ZSH_REV" \
    "$HOME/.oh-my-zsh"
  install_pinned_checkout \
    'zsh-autosuggestions' \
    'https://github.com/zsh-users/zsh-autosuggestions.git' \
    "$ZSH_AUTOSUGGESTIONS_REV" \
    "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions"
  install_pinned_checkout \
    'zsh-syntax-highlighting' \
    'https://github.com/zsh-users/zsh-syntax-highlighting.git' \
    "$ZSH_SYNTAX_HIGHLIGHTING_REV" \
    "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"
  install_pinned_checkout \
    'tmux plugin manager' \
    'https://github.com/tmux-plugins/tpm.git' \
    "$TPM_REV" \
    "$HOME/.tmux/plugins/tpm"
  install_pinned_checkout \
    'gruvbox' \
    'https://github.com/morhetz/gruvbox.git' \
    "$GRUVBOX_REV" \
    "$HOME/.vim/pack/colors/opt/gruvbox"
fi

if $run_links; then
  if $migrate_codex_instructions; then
    mv "$codex_instructions" "$codex_instructions_backup"
    printf 'Preserved empty Codex instructions at %s\n' \
      "$codex_instructions_backup"
  fi
  if $migrate_mise_config; then
    mv "$mise_home_config" "$mise_home_config_backup"
    printf 'Preserved previous Mise config at %s\n' "$mise_home_config_backup"
  fi
  if $migrate_standalone_mise; then
    mv "$standalone_mise" "$standalone_mise_backup"
    printf 'Preserved previous standalone Mise at %s\n' \
      "$standalone_mise_backup"
  fi

  $cleanup_root_claude && remove_retired_link \
    'root Claude instructions' "$HOME/.CLAUDE.md" "$repo_root/CLAUDE.md"
  $cleanup_root_agents && remove_retired_link \
    'root Codex instructions' "$HOME/.AGENTS.md" "$repo_root/AGENTS.md"
  $cleanup_agrc && remove_retired_link \
    'ag configuration' "$HOME/.agrc" "$repo_root/agrc"

  printf 'Linking dotfiles with rcm ...\n'
  if [ -d "$HOME/dotfiles-local" ]; then
    RCRC="$repo_root/rcrc" "$rcup_bin" \
      -d "$HOME/dotfiles-local" -d "$repo_root"
  else
    RCRC="$repo_root/rcrc" "$rcup_bin" -d "$repo_root"
  fi

  # Runs after rcup so anything still dangling is genuinely retired: rcm
  # creates links but never reclaims the ones whose source was deleted.
  prune_links=${DOTFILES_PRUNE_LINKS_BIN:-$repo_root/bin/dotfiles-prune-links}
  if [ -x "$prune_links" ]; then
    "$prune_links"
  else
    printf 'warning: cannot prune retired links: %s\n' "$prune_links" >&2
  fi
fi

if $run_runtimes; then
  printf 'Installing locked mise runtimes ...\n'
  mise_home_config=${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml
  # Deliberately not ignoring $mise_home_config: rcm links it to the file named
  # by MISE_GLOBAL_CONFIG_FILE, so ignoring it discarded the global config too
  # and mise silently resolved zero tools.
  MISE_GLOBAL_CONFIG_FILE="$repo_root/config/mise/config.toml" \
    MISE_GLOBAL_CONFIG_ROOT="$repo_root/config/mise" \
    "$mise_bin" install --locked -y
fi

$run_plugins && install_plugins

printf '%s\n' 'Bootstrap components completed. Run dotfiles-doctor for health checks.'
