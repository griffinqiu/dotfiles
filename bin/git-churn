#!/usr/bin/env ruby

require "open3"

def capture!(*command)
  stdout, stderr, status = Open3.capture3(*command)
  return stdout if status.success?

  warn stderr unless stderr.empty?
  exit status.exitstatus || 1
end

remote = ENV.fetch("GIT_CHURN_REMOTE", "origin")
helper = File.join(__dir__, "git-default-branch")
branch = capture!(helper, remote).strip

all_files = capture!("git", "log", "--all", "--name-only", "--format=format:")
  .lines(chomp: true)
  .reject(&:empty?)
changed_files = capture!("git", "log", "#{remote}/#{branch}..HEAD", "--name-only", "--format=format:")
  .lines(chomp: true)
  .reject(&:empty?)
  .uniq

counts = Hash.new(0)
all_files.each { |file| counts[file] += 1 }

changed_files
  .filter_map { |file| [counts[file], file] if counts.key?(file) }
  .sort_by { |count, file| [count, file] }
  .each { |count, file| printf("%7d %s\n", count, file) }
